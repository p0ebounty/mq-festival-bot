{
  "name": "mq-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @mq/db generate",
    "db:migrate": "pnpm --filter @mq/db migrate",
    "test:live": "LIVE_TESTS=1 vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "server-only": "^0.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
