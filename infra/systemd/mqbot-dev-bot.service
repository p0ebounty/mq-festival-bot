[Unit]
Description=MQ Bot — dev (bot + API, hot-reload)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/projects/bot/apps/bot
Environment=APP_ENV=dev
Environment=NODE_ENV=development
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CI=true
ExecStart=/projects/bot/apps/bot/node_modules/.bin/tsx watch src/index.ts
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mqbot-dev-bot

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/projects/bot /var/lib/mqbot

[Install]
WantedBy=multi-user.target
