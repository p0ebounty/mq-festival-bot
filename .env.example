# ============================================================
# MQ Bot — пример окружения. Копировать в .env.dev / .env.prod
# РЕАЛЬНЫЕ ЗНАЧЕНИЯ СЮДА НЕ ПИСАТЬ. Этот файл коммитится.
# ============================================================

# --- стенд ---
NODE_ENV=development          # development | production
APP_ENV=dev                   # dev | prod
PUBLIC_URL=https://bot-dev.example.com
PORT=3001                     # Fastify (бот + API)
ADMIN_PORT=3002               # Next.js (админка)

# --- Telegram ---
# Токен от @BotFather. Свой для каждого стенда!
TELEGRAM_BOT_TOKEN=
# Случайная строка: путь вебхука /tg/<секрет> + заголовок
# X-Telegram-Bot-Api-Secret-Token. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- база данных ---
DATABASE_URL=postgresql://mqbot:PASSWORD@127.0.0.1:5432/mqbot_dev

# --- шифрование секретов в БД ---
# Ключ AES-256-GCM для настроек, хранимых в БД (ключ kie.ai и т.п.).
# Ровно 64 hex-символа. Сгенерировать: openssl rand -hex 32
# ВНИМАНИЕ: потеря ключа = потеря всех зашифрованных настроек.
SECRETS_ENC_KEY=

# --- kie.ai ---
# ТОЛЬКО bootstrap. Штатно ключ вводится в админке и хранится в БД
# зашифрованным; значение из БД имеет приоритет над этим.
KIE_API_KEY=
# HMAC-ключ вебхука с kie.ai/settings. Пустой = подпись callback не проверяется.
KIE_WEBHOOK_HMAC_KEY=
KIE_API_BASE=https://api.kie.ai
KIE_CLAUDE_BASE=https://api.kie.ai/claude

# --- админка ---
# Пароль задаётся один раз при сидинге: pnpm admin:create
ADMIN_SESSION_SECRET=

# --- хранилище ---
MEDIA_ROOT=/var/lib/mqbot/dev/media
MEDIA_RETENTION_DAYS=30

# --- логи ---
LOG_LEVEL=info
