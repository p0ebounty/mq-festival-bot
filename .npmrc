auto-install-peers=true
strict-peer-dependencies=false
# pnpm 10+ гоняет "pnpm install" перед каждым run/exec и падает на
# предупреждении об ignored build scripts. Бинарники esbuild приезжают
# из платформенного пакета @esbuild/linux-x64, постинстал не нужен.
# Эта же проверка ломала запуск под systemd (нет TTY).
verify-deps-before-run=false
